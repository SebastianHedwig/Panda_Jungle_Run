{
  "source": {
    "include": ["src", "initGame.js"],
    "includePattern": "\\.js$",
    "exclude": ["node_modules", "assets", "styles", "docs"]
  },
  "opts": {
    "destination": "docs/jsdoc",
    "recurse": true,
    "encoding": "utf8",
    "readme": "README.md",
    "template": "node_modules/docdash-orange"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
